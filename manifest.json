{
  "action": {
    "default_icon": {
      "16": "icons/lexigo-16.png",
      "32": "icons/lexigo-32.png",
      "48": "icons/lexigo-48.png",
      "128": "icons/lexigo-128.png"
    },
    "default_title": "Lexigo options"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "content/vendor/floating-ui.core.umd.min.js",
        "content/vendor/floating-ui.dom.umd.min.js",
        "content/lexigo.js"
      ],
      "run_at": "document_end"
    }
  ],
  "description": "An instantly accessible dictionary right in your browser.",
  "homepage_url": "https://github.com/jortvanleenen/lexigo",
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://noai.duckduckgo.com/*"
  ],
  "icons": {
    "16": "icons/lexigo-16.png",
    "32": "icons/lexigo-32.png",
    "48": "icons/lexigo-48.png",
    "64": "icons/lexigo-64.png",
    "128": "icons/lexigo-128.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "109",
  "name": "Lexigo",
  "options_ui": {
    "open_in_tab": false,
    "page": "options/options.html"
  },
  "permissions": ["offscreen", "storage"],
  "version": "2.0.1",
  "web_accessible_resources": [
    {
      "resources": ["content/popup.html", "content/popup.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
