{
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "options/options.html",
    "default_title": "Define Select Dictionary options"
  },
  "background": {
    "service_worker": "background/background.js",
    "scripts": ["shared/ddg-parser.js", "background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "content/vendor/floating-ui.core.umd.min.js",
        "content/vendor/floating-ui.dom.umd.min.js",
        "content/define-select-dictionary.js"
      ],
      "run_at": "document_end"
    }
  ],
  "description": "An instantly accessible dictionary right in your browser.",
  "homepage_url": "https://github.com/eldon922/define-select-dictionary",
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://noai.duckduckgo.com/*",
    "https://translate.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "109",
  "name": "Define Select Dictionary",
  "options_ui": {
    "open_in_tab": false,
    "page": "options/options.html"
  },
  "permissions": ["offscreen", "storage"],
  "version": "1.1.0",
  "web_accessible_resources": [
    {
      "resources": ["content/popup.html", "content/popup.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "define-select-dictionary@eldon922",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
