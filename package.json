{
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/css": "^0.11.0",
    "@eslint/js": "^9.35.0",
    "@floating-ui/core": "1.7.5",
    "@floating-ui/dom": "1.7.6",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.4.0",
    "playwright-core": "^1.56.0",
    "prettier": "3.6.2",
    "web-ext": "^10.4.0"
  },
  "scripts": {
    "dev": "npm run build && web-ext --no-config-discovery run --source-dir=dist/chromium --target=chromium",
    "dev:firefox": "npm run build && web-ext --no-config-discovery run --source-dir=dist/firefox --target=firefox-desktop",
    "build": "node scripts/package.mjs",
    "lint:firefox": "npm run build && web-ext lint --no-config-discovery --source-dir=dist/firefox",
    "screenshots": "node scripts/screenshots.mjs",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "npm run lint && npm run format"
  }
}
